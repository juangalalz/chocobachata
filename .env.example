# Checkout de Lemon Squeezy. Cuando esté la cuenta, pega aquí la URL del producto.
# Los dos botones de Comprar ahora abren esa dirección y conservan los parámetros del anuncio.
NEXT_PUBLIC_CHECKOUT_URL=https://choco.lemonsqueezy.com/checkout/buy/f8942fd3-b7a2-48be-a032-cb7acea8a267?media=0&desc=0&discount=0

# Píxel de Meta y token de la API de conversiones. Sin estos dos, la página igual guarda las visitas.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Supabase guarda visitas y pedidos. Sin esto, un reintento de Lemon repite los correos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy firma el aviso del pago con este secreto. Se crea al registrar el webhook.
LEMON_WEBHOOK_SECRET=

# Sitio y los tres programas de bachata. La clave la genera el dueño de la cuenta de Wix.
WIX_SITE_ID=
WIX_API_KEY=
WIX_PROGRAM_IDS=7c4cdea8-df01-43e9-aa4a-639cdea32039,01227ab3-3c7e-4ee4-9102-a39d83ffe67f,269e9cf4-732b-4405-b3ae-b809595db19d
